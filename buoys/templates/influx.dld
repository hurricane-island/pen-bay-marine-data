StationName = bench_test

Const SCAN_INTERVAL_S As Long = 60 ' Diagnostic scan Interval
Dim BatteryVoltage As Float: Units BatteryVoltage = Volts
Dim InternalTemperature As Float: Units InternalTemperature = °C
Dim RSSI = NAN
Public DiagnosticsStringBuffer As String * 256
Public http_header_content As String * 100 = "Content-Type:text/plain; charset=utf-8"
Public http_post_response As String * 256
Public http_post_tx As Long
Public http_body As String * 512
Dim server_url As String * 256 = "http://cr-to-influx.hurricane-island.workers.dev"

DataTable(Diagnostics, True, 3000)
  Sample(1, BatteryVoltage, FP2)
  Sample(1, RSSI, FP2) ' Placeholder to test NaN handling
EndTable

BeginProg
  SetSetting("PakBusTCPClients", "(drema.konectgds.com,9200)")
  SetSetting("PakBusAddress", 1064)
  SetSetting("CellEnabled", True)
  SetSetting("CellAPN", "so01.VZWSTATIC")
  SetSetting("CellPwrStartTime", 1440)
  SetSetting("CellPwrDuration", 10)
  SetSetting("CellPwrRepeat", 1440)
  SetSetting("CellBillingDay", 1)
  SetSetting("CellKeepAlive", "www.google.com") ' If this fails, the datalogger will re-establish
  SetSetting("CellKeepAliveTime", 30) ' How often to ping test the link
  ExciteV(Vx2, 0, 0)
  IPNetPower(5, True)

  Scan (SCAN_INTERVAL_S, Sec, 0, 0)
    Battery(BatteryVoltage)
    CallTable Diagnostics
  NextScan

  SlowSequence
    Scan(15, Sec, 0, 0)
        GetRecord(DiagnosticsStringBuffer, Diagnostics, 1)
        http_body = "diagnostics,wynken," + DiagnosticsStringBuffer
        http_post_tx = HttpPost(server_url, http_body, http_post_response, http_header_content)
    NextScan
  EndSequence
EndProg
